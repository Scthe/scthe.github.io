---
import { getYear } from 'date-fns';

import { getSiteMeta } from '../../constants';
import { dateToXmlSchema } from '../../utils';
import type { ArticleType, WebsiteType } from './types';

// TODO [migration] double check all SEO is same

export interface Props {
  title: string;
  description: string;
  image: string;
  url: string;
  type: ArticleType | WebsiteType;
}

const { title, description, image, url, type } = Astro.props;

const siteMeta = getSiteMeta();
const author: string = siteMeta.author.name;
const myPageUrl: string = siteMeta.siteUrl; // fb's: article:author, article:publisher

const ldJsonPerson = (name: string) => ({ '@type': 'Person', name });
const ldJsonImageObject = (imgUrl: string) => ({
  '@type': 'ImageObject',
  url: imgUrl,
});

const ldJsonArticle = (type: ArticleType) => ({
  '@context': 'http://schema.org',
  '@type': 'Article',
  name: title,
  headline: title,
  author: ldJsonPerson(author),
  copyrightHolder: ldJsonPerson(author),
  creator: ldJsonPerson(author),
  copyrightYear: '' + getYear(type.datePublished), // '2019',
  datePublished: dateToXmlSchema(type.datePublished),
  dateModified: dateToXmlSchema(type.dateModified),
  description,
  inLanguage: 'en_US',
  url,
  mainEntityOfPage: url,
  image: ldJsonImageObject(image),
});

const ldJsonOther = () => ({
  '@context': 'http://schema.org',
  '@type': 'WebPage',
  url,
  headline: title,
  inLanguage: 'en_US',
  mainEntityOfPage: url,
  description,
  name: title,
  author: ldJsonPerson(author),
  copyrightHolder: ldJsonPerson(author),
  copyrightYear: '' + getYear(new Date()),
  creator: ldJsonPerson(author),
  publisher: ldJsonPerson(author),
  datePublished: dateToXmlSchema(new Date()),
  dateModified: dateToXmlSchema(new Date()),
  image: ldJsonImageObject(image),
});

const ldJson = type.type === 'article' ? ldJsonArticle(type) : ldJsonOther();
---

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content={siteMeta.title || ''} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={url} />
<meta property="og:type" content={type.type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={description} />

<!-- Twitter -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={description} />
<meta name="twitter:url" content={url} />

<!-- Article-only extra tags -->
{
  type.type === 'article' && (
    <>
      <meta property="article:author" content={myPageUrl} />
      <meta property="article:publisher" content={myPageUrl} />
      <meta
        property="article:published_time"
        content={dateToXmlSchema(type.datePublished)}
      />
    </>
  )
}

<!-- schema.org structured data -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(ldJson)}
/>
