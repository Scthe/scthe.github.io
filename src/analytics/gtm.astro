---
// Google Analytics (gtag). Only rendered in productions builds.
const isProdBuild = import.meta.env.PROD;
---

{isProdBuild && (
  <>
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=UA-66646958-1"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'UA-66646958-1', {
        anonymize_ip: true,
        cookie_expires: 0,
      });
    </script>
  </>
)}
